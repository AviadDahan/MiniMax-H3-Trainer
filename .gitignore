__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/

# Never commit weights, caches, datasets or run outputs.
*.safetensors
*.pt
*.mp4
*.wav

# ...except the demo clips. GitHub will not play a <video> tag with a relative
# src, so the README shows animated webp previews and links these for the audio,
# which for a model whose whole point is joint video *and* sound is half the
# evidence on its own.
!docs/demo/*.mp4
.precomputed/
outputs/
runs/
wandb/

# Collected run outputs. artifacts/README.md is the index and IS tracked; the
# media and weights inside are not -- they are reproducible with
# scripts/collect_artifacts.sh from /data/aviad/runs.
artifacts/**
!artifacts/README.md
